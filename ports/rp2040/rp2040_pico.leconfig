{
  "device": {
    "name": "Raspberry Pi Pico RP2040",
    "firmware_version": "1.0",
    "protocol_version": 1
  },
  "limits": {
    "workspace_bytes": 4096,
    "config_slots": 4,
    "slot_size_bytes": 4096,
    "ns_per_abstract_cycle": 400
  },
  "features": {
    "protection": true,
    "complex": true,
    "analog": true,
    "dsp": true,
    "serial_bus": true,
    "i2c_devices": 2,
    "spi_devices": 2
  },
  "pin_map": {
    "digital": {
      "inputs": {
        "%I0": {"alias": "BTN_A", "desc": "Pushbutton A (Pull-up)"},
        "%I1": {"alias": "BTN_B", "desc": "Pushbutton B (Pull-up)"},
        "%I2": {"alias": "SENSOR_TRIG", "desc": "Digital Proximity Sensor"},
        "%I3": {"alias": "IN3", "desc": "Digital Input 3"},
        "%I4": {"alias": "IN4", "desc": "Digital Input 4"},
        "%I5": {"alias": "IN5", "desc": "Digital Input 5"},
        "%I6": {"alias": "IN6", "desc": "Digital Input 6"},
        "%I7": {"alias": "IN7", "desc": "Digital Input 7"},
        "%I8": {"alias": "IN8", "desc": "Digital Input 8"},
        "%I9": {"alias": "IN9", "desc": "Digital Input 9"},
        "%I10": {"alias": "IN10", "desc": "Digital Input 10"},
        "%I11": {"alias": "IN11", "desc": "Digital Input 11"},
        "%I12": {"alias": "IN12", "desc": "Digital Input 12"},
        "%I13": {"alias": "IN13", "desc": "Digital Input 13"},
        "%I14": {"alias": "IN14", "desc": "Digital Input 14"},
        "%I15": {"alias": "IN15", "desc": "Digital Input 15"}
      },
      "outputs": {
        "%Q0": {"alias": "PICO_LED", "desc": "Onboard Green LED"},
        "%Q1": {"alias": "RELAY_1", "desc": "External Relay Channel 1"},
        "%Q2": {"alias": "RELAY_2", "desc": "External Relay Channel 2"},
        "%Q3": {"alias": "OUT3", "desc": "Digital Output 3"},
        "%Q4": {"alias": "OUT4", "desc": "Digital Output 4"},
        "%Q5": {"alias": "OUT5", "desc": "Digital Output 5"},
        "%Q6": {"alias": "OUT6", "desc": "Digital Output 6"},
        "%Q7": {"alias": "OUT7", "desc": "Digital Output 7"},
        "%Q8": {"alias": "OUT8", "desc": "Digital Output 8"},
        "%Q9": {"alias": "OUT9", "desc": "Digital Output 9"},
        "%Q10": {"alias": "OUT10", "desc": "Digital Output 10"},
        "%Q11": {"alias": "OUT11", "desc": "Digital Output 11"},
        "%Q12": {"alias": "OUT12", "desc": "Digital Output 12"},
        "%Q13": {"alias": "OUT13", "desc": "Digital Output 13"},
        "%Q14": {"alias": "OUT14", "desc": "Digital Output 14"},
        "%Q15": {"alias": "OUT15", "desc": "Digital Output 15"}
      }
    },
    "analog": {
      "inputs": {
        "%AIN0": {"alias": "ADC0", "desc": "Analog Channel 0 (0-3.3V)"},
        "%AIN1": {"alias": "ADC1", "desc": "Analog Channel 1 (0-3.3V)"},
        "%AIN2": {"alias": "ADC2", "desc": "Analog Channel 2 (0-3.3V)"}
      },
      "outputs": {}
    }
  },
  "custom_nodes": [
    {
      "type_id": "RP2040_PIO_Stepper",
      "display_name": "PIO Stepper Driver",
      "category": "RP2040 Peripherals",
      "description": "Deterministic PIO state machine step/dir generator",
      "function_id": 1,
      "color": "#E91E63",
      "inputs": [
        {"name": "StepEnable", "type": "bool", "default": false},
        {"name": "Direction", "type": "bool", "default": true}
      ],
      "outputs": [
        {"name": "StepActive", "type": "bool"}
      ],
      "properties": [
        {"key": "step_rate_hz", "label": "Step Rate (Hz)", "type": "int", "default": 5000, "min": 100, "max": 100000}
      ]
    }
  ]
}
