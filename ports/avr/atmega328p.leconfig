{
  "device": {
    "name": "Arduino Uno (ATmega328P)",
    "firmware_version": "1.0",
    "protocol_version": 1
  },
  "limits": {
    "workspace_bytes": 512,
    "config_slots": 2,
    "slot_size_bytes": 512,
    "ns_per_abstract_cycle": 3000
  },
  "features": {
    "protection": false,
    "complex": true,
    "analog": true,
    "dsp": true,
    "serial_bus": true,
    "i2c_devices": 1,
    "spi_devices": 1
  },
  "pin_map": {
    "digital": {
      "inputs": {
        "%I0": {"alias": "BTN_START", "desc": "Start Button"},
        "%I1": {"alias": "BTN_STOP", "desc": "Stop Button"},
        "%I2": {"alias": "LIMIT_SW", "desc": "Limit Switch"},
        "%I3": {"alias": "IN3", "desc": "Digital Input 3"},
        "%I4": {"alias": "IN4", "desc": "Digital Input 4"},
        "%I5": {"alias": "IN5", "desc": "Digital Input 5"}
      },
      "outputs": {
        "%Q0": {"alias": "LED_BUILTIN", "desc": "Onboard LED"},
        "%Q1": {"alias": "PUMP_RELAY", "desc": "Sump Pump Relay"},
        "%Q2": {"alias": "VALVE_SOLENOID", "desc": "Inlet Solenoid Valve"},
        "%Q3": {"alias": "OUT3", "desc": "Digital Output 3"},
        "%Q4": {"alias": "OUT4", "desc": "Digital Output 4"},
        "%Q5": {"alias": "OUT5", "desc": "Digital Output 5"}
      }
    },
    "analog": {
      "inputs": {
        "%AIN0": {"alias": "AIN0", "desc": "Analog Input 0 (0-5V)"},
        "%AIN1": {"alias": "AIN1", "desc": "Analog Input 1 (0-5V)"},
        "%AIN2": {"alias": "AIN2", "desc": "Analog Input 2 (0-5V)"},
        "%AIN3": {"alias": "AIN3", "desc": "Analog Input 3 (0-5V)"},
        "%AIN4": {"alias": "AIN4", "desc": "Analog Input 4 (0-5V)"},
        "%AIN5": {"alias": "AIN5", "desc": "Analog Input 5 (0-5V)"}
      },
      "outputs": {}
    }
  },
  "custom_nodes": [
    {
      "type_id": "AVR_Fast_PWM",
      "display_name": "Fast PWM Out",
      "category": "AVR Peripherals",
      "description": "Direct 8-bit Timer0 hardware PWM generator",
      "function_id": 1,
      "color": "#D84315",
      "inputs": [
        {"name": "Duty", "type": "float", "default": 128.0}
      ],
      "outputs": [
        {"name": "Active", "type": "bool"}
      ],
      "properties": [
        {"key": "prescaler", "label": "Prescaler", "type": "enum", "default": "64", "options": ["1", "8", "64", "256", "1024"]}
      ]
    }
  ]
}
